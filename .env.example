# ============================================================
# Paddle 環境設定
# コピーして .env.local を作成し、値を埋めてください:
#   copy .env.example .env.local   (Windows)
# .env.local は git にコミットしないこと。
# ============================================================

# 必須: "sandbox" または "production"。
# デフォルトはありません — 未設定だとアプリは起動時に大声で失敗します
# (間違ったPaddleアカウントに対して動くのを防ぐため)。
NEXT_PUBLIC_PADDLE_ENV=sandbox

# 必須: クライアントサイドトークン。
# Paddle (Sandbox) > Developer Tools > Authentication > Client-side tokens で作成。
# sandbox は test_ 、production は live_ で始まります。
# これはブラウザに公開される前提のトークンです (NEXT_PUBLIC_ でOK)。
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- サーバーAPIキーについて ---
# サーバーAPIキー (pdl_..._apikey_...) はこのフロントエンドでは使いません。
# 将来 Webhook 処理やサーバーサイドAPI呼び出しを追加する場合のみ、
# NEXT_PUBLIC_ を付けない変数として追加してください。例:
#   PADDLE_API_KEY=pdl_sdbx_apikey_xxxxxxxx
# NEXT_PUBLIC_ を付けるとブラウザに漏れます。絶対に付けないこと。

# --- Webhook (フルフィルメント) 用 ---
# Paddle > Developer Tools > Notifications で Destination を作成すると
# 発行されるシークレットキー (pdl_ntfset_... 形式)。
# サーバー専用。NEXT_PUBLIC_ を付けるとブラウザに漏れるので絶対に付けない。
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxxxxx
